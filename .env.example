# ── Meeting booking → Google Calendar + Meet ────────────────────────────────
# One-time setup by the site owner (see README "Backend: booking & newsletter"):
# 1. console.cloud.google.com → new project → enable "Google Calendar API"
# 2. OAuth consent screen (External, add the owner's Gmail as test user)
# 3. Credentials → OAuth client ID (Web application), add
#    https://developers.google.com/oauthplayground as an authorized redirect URI
# 4. In the OAuth Playground (gear icon → use your own credentials), authorize
#    scope https://www.googleapis.com/auth/calendar.events + calendar.freebusy,
#    exchange for tokens, copy the refresh token below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional; defaults to the owner's primary calendar
GOOGLE_CALENDAR_ID=primary

# ── Admin panel (/admin) ─────────────────────────────────────────────────────
# Password the editor types into the panel. Panel is fully locked without it.
ADMIN_PASSWORD=
# Fine-grained GitHub personal access token with Contents read/write on the
# site repo only (github.com → Settings → Developer settings → Tokens).
# Publishing commits the article to the repo, which triggers a redeploy.
GITHUB_TOKEN=
GITHUB_REPO=JamesBaisus/The-Human-Thread
GITHUB_BRANCH=main

# ── Supabase (content + media storage) ───────────────────────────────────────
# Replaces the repo as the place articles and their pictures live. The point is
# to decouple publishing from deploying: today every publish is a git commit,
# so an article cannot appear until the site rebuilds — which is why a blocked
# deploy stopped all publishing. Reading from Supabase at request time means a
# publish shows up immediately, with no deploy at all.
#
# Create at supabase.com → New project, then Project Settings → API for the
# URL and keys, and Storage → New bucket for the pictures.

# Project URL, e.g. https://abcdefghijklm.supabase.co
# Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable ("anon") key. Safe in the browser: it can only do what your
# Row Level Security policies allow, so give the content tables a policy
# granting public SELECT and nothing else.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret ("service_role") key. Bypasses Row Level Security entirely, so it is
# the credential the admin panel writes with.
# NEVER prefix this NEXT_PUBLIC_, never import it into a client component, and
# never commit a filled-in value: anything NEXT_PUBLIC_ is compiled into the
# browser bundle and would hand every visitor full write access.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket holding covers and article pictures. Make it public-read so
# next/image can fetch from it; writes stay behind the service role key.
SUPABASE_STORAGE_BUCKET=media
